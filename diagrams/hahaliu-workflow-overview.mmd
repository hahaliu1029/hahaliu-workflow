graph TD
    A["用户提出工程任务"] --> B["读取用户指令、宿主规则与项目规则"]
    B --> C{"项目 auto-skill 覆盖当前任务？"}
    C -- "是" --> D["项目 auto-skill 负责业务路由"]
    C -- "否" --> E{"按任务形状与风险定档"}
    E --> F["fast：定位 → 快照 → 最小修改"]
    E --> G{"focused：选择证据循环"}
    E --> H["full：澄清 → 计划 → 切片 → 多轴评审"]
    E --> I["review：只读取证 → 分轴 findings"]
    G -- "bug / 功能" --> G1["复现 → RED → GREEN → 评审"]
    G -- "性能优化" --> G2["基线 → profile → 单变量修改 → 同条件复测"]
    G -- "行为保持重构" --> G3["GREEN / characterization → 小步等价变换 → 逐步回归"]
    D --> J["执行唯一主链；有修改时用 Task Delta 隔离"]
    F --> J
    G1 --> J
    G2 --> J
    G3 --> J
    H --> J
    I --> J
    J --> K["运行当次验证并重放验收标准"]
    K --> L{"目标、实现与证据一致？"}
    L -- "是" --> V["Verified Complete"]
    L -- "否" --> R{"失败分类：本任务 / 原有 / 环境"}
    R -- "可在授权范围内修复" --> J
    R -- "原有且不影响本次验收" --> V
    R -- "环境阻塞或缺少必要授权" --> Q["BLOCKED：说明证据、缺口与下一步"]
    V --> M{"需要 Git、发布或外部副作用？"}
    M -- "否" --> O["交付结果、Delta、证据、风险与 Git 状态"]
    M -- "是，且已获本次明确授权" --> N["只执行获授权的具体动作"]
    M -- "是，但未授权" --> U["不执行；报告未授权动作"]
    Q --> O
    U --> O
    N --> O
